#!/bin/bash

source "$HOME/.config/colors.sh"
source "$HOME/.config/icons.sh"
source "$HOME/Developer/github/dotfiles/sketchybar/icon_map.sh"

PLUGIN_DIR="$HOME/Developer/github/dotfiles/sketchybar/plugins"
ITEM_DIR="$HOME/Developer/github/dotfiles/sketchybar/items"

sketchybar --add event aerospace_workspace_change

sketchybar --bar color=0x00000000 \
        height=40 \
        margin=0 \
        y_offset=0 \
        padding_left=8 \
        padding_right=8



sketchybar --default \
        \
        background.border_width=0 \
        background.height=30 \
        background.corner_radius=15 \
        \
        icon.highlight_color="$COLOR_BACKGROUND" \
        icon.padding_left=4 \
        icon.padding_right=1 \
        icon.font="CaskaydiaCove Nerd Font:Regular:12.0" \
        \
        label.highlight_color="$COLOR_BACKGROUND" \
        label.padding_left=2 \
        label.padding_right=6 \
        label.font="Iosevka:Medium Extended:13.0"
# font_smoothing=true

sketchybar --add item time right \
        --set time script="$PLUGIN_DIR/time.sh" \
        update_freq=5 \
        padding_left=2 \
        padding_right=4 \
        background.color="$COLOR_WHITE" \
        background.border_width=0 \
        background.corner_radius=15 \
        background.height=24 \
        icon="$ICON_CLOCK" \
        icon.highlight=on \
        label.highlight=on \
        --add item date right \
        --set date script="$PLUGIN_DIR/date.sh" \
        update_freq=60 \
        padding_left=8 \
        padding_right=2 \
        background.border_width=0 \
        background.height=24 \
        icon="$ICON_CALENDAR" \
        icon.color="$COLOR_WHITE" \
        label.color="$COLOR_WHITE"

sketchybar --add bracket clock time date \
        --set clock background.color="$COLOR_BACKGROUND" \
        background.border_color="$COLOR_WHITE"


sketchybar --add item ip_address left \
        --set ip_address script="$PLUGIN_DIR/ip_address.sh" \
        update_freq=30 \
        padding_left=2 \
        padding_right=2 \
        background.color="$COLOR_WHITE" \
        background.border_width=0 \
        background.corner_radius=15 \
        background.height=24 \
        icon.highlight=on \
        label.highlight=on \
        --subscribe ip_address wifi_change \
        \
        --add item battery left \
        --set battery script="$PLUGIN_DIR/battery.sh" \
        update_freq=120 \
        padding_left=2 \
        padding_right=8 \
        background.border_width=0 \
        background.height=24 \
        --subscribe battery system_woke power_source_change

sketchybar --add bracket status ip_address battery \
        --set status background.color="$COLOR_BACKGROUND" \
        background.border_color="$COLOR_WHITE"

source "$ITEM_DIR"/aerospace.sh

sketchybar \
        --add alias "AeroSpace,Item-0" right \
        --add alias "Stats,Network_speed" right \
        --add alias "Stats,CPU_mini" right \
        --add alias "Stats,RAM_bar_chart" right \
        --add alias "Notion Calendar,Item-0" right

sketchybar --update
